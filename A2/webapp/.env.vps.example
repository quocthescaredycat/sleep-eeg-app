# Server settings for compose.vps.yaml: cp .env.vps.example .env, then fill in (docs/vps.md).

# Plain `docker compose ...` then always uses the server override and starts Qdrant. Without
# it, `docker compose up` would publish port 8080 on every interface, past ufw.
COMPOSE_FILE=compose.yaml:compose.vps.yaml
COMPOSE_PROFILES=similarity

# Required. Read by PostgreSQL only when its volume is first created: set it before the first
# `up`. Letters and digits only, since it is part of a URL: openssl rand -hex 24
POSTGRES_PASSWORD=

BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# CPU cores for one inference job; the worker container is capped at the same number.
TORCH_THREADS=2

# Uploads are deleted after this many days (0 = never).
RETENTION_DAYS=30

# Copied from the Mac with rsync (docs/vps.md). These are the defaults.
CHECKPOINTS_DIR=./backend/checkpoints
LIBRARY_DIR=./backend/library
