# Runtime data and secrets
data/
.env

# Trained weights stay out of Git; manifests (with SHA-256) are committed.
backend/checkpoints/**/*.pt
backend/checkpoints/**/*.part

# Similarity library (several GB, scripts/build_library.py): only provenance and the
# Phase 2 evaluation are committed.
backend/library/*
!backend/library/manifest.json
!backend/library/library_eval.json

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Node and Playwright
node_modules/
dist/
*.tsbuildinfo
test-results/
playwright-report/
